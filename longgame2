            if (tttBoard[idx] !== '') return;
            tttBoard[idx] = 'X'; SFX.tttX(); renderTicTacToeBoard();
            if (checkTicTacToeWin()) { endTicTacToe(checkTicTacToeWin()); return; }
            if (tttBoard.every(c => c !== '')) { endTicTacToe('draw'); return; }
            tttCurrentTurn = 'ai'; tttLocked = true;
            setTimeout(aiTicTacToeMove, 500);
