        function startReactionRound() {
            if (reactionState === 'waiting' || reactionState === 'go') return;
            reactionState = 'waiting';
            reactionTarget.className = 'reaction-target waiting';
            reactionTarget.textContent = t('reactionReady');
            reactionLog.innerHTML = '<p>' + t('reactionReadyMsg') + '</p>';
            const delay = getReactionDelay();
            reactionTimer = setTimeout(() => {
                reactionState = 'go';
