            }
        }
        whackStartBtn.addEventListener('click', () => { SFX.click(); startWhackGame(); });
        whackResetBtn.addEventListener('click', () => {
            SFX.click();
            if (whackTimer) clearInterval(whackTimer);
            if (whackSpawnTimer) clearInterval(whackSpawnTimer);
            whackTimer = null; whackSpawnTimer = null; whackPlaying = false;
            whackScore = 0; whackMiss = 0; whackTimeLeft = 30;
            whackScoreEl.textContent = '0'; whackMissEl.textContent = '0'; whackTimeEl.textContent = '30s';
            whackLog.innerHTML = '<p>' + t('whackHint') + '</p>';
            initWhackBoard();
        });
        initWhackBoard();

        // ============================================================
        //  猜拳（简化保留）
        // ============================================================
        const rpsPlayerChoice = document.getElementById('rpsPlayerChoice');
        const rpsAIChoice = document.getElementById('rpsAIChoice');
        const rpsWinEl = document.getElementById('rpsWin');
        const rpsLoseEl = document.getElementById('rpsLose');
        const rpsDrawEl = document.getElementById('rpsDraw');
        const rpsStreakEl = document.getElementById('rpsStreak');
        const rpsButtons = document.querySelectorAll('.rps-btn');
        const rpsResetBtn = document.getElementById('rpsResetBtn');
        const rpsLog = document.getElementById('rpsLog');
        const rpsDiffSwitch = document.getElementById('rpsDiffSwitch');
        const rpsDiffBtns = rpsDiffSwitch.querySelectorAll('.diff-btn');
        let rpsWins = 0, rpsLoses = 0, rpsDraws = 0, rpsStreak = 0, rpsBestStreak = 0;
        let rpsDifficulty = 'easy', rpsPlayerHistory = [], rpsPlaying = false;

        rpsDiffBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                SFX.click(); rpsDiffBtns.forEach(b => b.classList.remove('active')); btn.classList.add('active');
                rpsDifficulty = btn.dataset.rdiff;
            });
        });
        const RPS_EMOJI = { rock: '✊', paper: '✋', scissors: '✌️' };
        const RPS_BEATS = { rock: 'scissors', paper: 'rock', scissors: 'paper' };
        function getAIChoice() {
            if (rpsDifficulty === 'easy') return ['rock', 'paper', 'scissors'][Math.floor(Math.random() * 3)];
            if (rpsDifficulty === 'medium') {
                if (rpsPlayerHistory.length === 0 || Math.random() < 0.5) return ['rock', 'paper', 'scissors'][Math.floor(Math.random() * 3)];
                return RPS_BEATS[rpsPlayerHistory[rpsPlayerHistory.length - 1]];
            }
            if (rpsPlayerHistory.length < 3) return ['rock', 'paper', 'scissors'][Math.floor(Math.random() * 3)];
            const counts = { rock: 0, paper: 0, scissors: 0 };
            rpsPlayerHistory.slice(-5).forEach(c => counts[c]++);
            let mostCommon = 'rock', maxCount = 0;
            for (const k in counts) { if (counts[k] > maxCount) { maxCount = counts[k]; mostCommon = k; } }
            return RPS_BEATS[mostCommon];
        }
        function updateRpsStats() {
            rpsWinEl.textContent = rpsWins; rpsLoseEl.textContent = rpsLoses;
            rpsDrawEl.textContent = rpsDraws; rpsStreakEl.textContent = rpsStreak;
        }
        function handleRpsChoice(playerChoice) {
            if (rpsPlaying) return;
            rpsPlaying = true;
            rpsPlayerHistory.push(playerChoice);
            rpsPlayerChoice.textContent = RPS_EMOJI[playerChoice];
            rpsAIChoice.textContent = '❔';
            rpsLog.innerHTML = '<p>...</p>';
            setTimeout(() => {
                const aiChoice = getAIChoice();
                rpsAIChoice.textContent = RPS_EMOJI[aiChoice];
                let result;
                if (playerChoice === aiChoice) {
                    result = 'draw'; rpsDraws++; SFX.rpsDraw();
                    rpsLog.innerHTML = `<p>🤝 ${t('rpsDrawMsg')}</p>`; rpsStreak = 0;
                } else if (RPS_BEATS[playerChoice] === aiChoice) {
                    result = 'win'; rpsWins++; rpsStreak++;
                    if (rpsStreak > rpsBestStreak) rpsBestStreak = rpsStreak;
                    SFX.rpsWin();
                    rpsLog.innerHTML = `<p>🎉 ${t('rpsWinMsg')}</p>`;
                } else {
                    result = 'lose'; rpsLoses++; rpsStreak = 0; SFX.rpsLose();
                    rpsLog.innerHTML = `<p>😢 ${t('rpsLoseMsg')}</p>`;
                }
                updateRpsStats();
                rpsPlaying = false;
            }, 500);
        }
        rpsButtons.forEach(btn => { btn.addEventListener('click', () => handleRpsChoice(btn.dataset.choice)); });
        rpsResetBtn.addEventListener('click', () => {
            SFX.click();
            rpsWins = 0; rpsLoses = 0; rpsDraws = 0; rpsStreak = 0; rpsBestStreak = 0;
            rpsPlayerHistory = []; rpsPlaying = false;
            rpsPlayerChoice.textContent = '❔'; rpsAIChoice.textContent = '❔';
            updateRpsStats(); rpsLog.innerHTML = '<p>' + t('rpsHint') + '</p>';
        });
        updateRpsStats();

        // ============================================================
        //  颜色记忆（简化保留）
        // ============================================================
        const colormemBoard = document.getElementById('colormemBoard');
        const colormemRoundEl = document.getElementById('colormemRound');
        const colormemBestEl = document.getElementById('colormemBest');
        const colormemScoreEl = document.getElementById('colormemScore');
        const colormemStatusEl = document.getElementById('colormemStatus');
        const colormemStartBtn = document.getElementById('colormemStartBtn');
        const colormemResetBtn = document.getElementById('colormemResetBtn');
        const colormemLog = document.getElementById('colormemLog');
        const colormemDiffSwitch = document.getElementById('colormemDiffSwitch');
        const colormemDiffBtns = colormemDiffSwitch.querySelectorAll('.diff-btn');
        const COLORMEM_COLORS = [
            { name: 'red', color: '#e74c3c' }, { name: 'green', color: '#2ecc71' },
            { name: 'blue', color: '#3498db' }, { name: 'yellow', color: '#f1c40f' },
            { name: 'purple', color: '#9b59b6' }, { name: 'orange', color: '#e67e22' },
            { name: 'pink', color: '#fd79a8' }, { name: 'cyan', color: '#00cec9' },
            { name: 'lime', color: '#a3e635' }
        ];
        let colormemSequence = [], colormemPlayerIndex = 0;
        let colormemRound = 0, colormemBest = 0, colormemScore = 0;
        let colormemPlaying = false, colormemAccepting = false, colormemTimeouts = [];
        let colormemDifficulty = 'easy';

        colormemDiffBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                SFX.click(); colormemDiffBtns.forEach(b => b.classList.remove('active')); btn.classList.add('active');
                colormemDifficulty = btn.dataset.cdiff;
            });
        });
        function getColormemColorCount() {
            if (colormemDifficulty === 'easy') return 4;
            if (colormemDifficulty === 'medium') return 6;
            return 9;
        }
        function getColormemSpeed() {
            if (colormemDifficulty === 'easy') return 700;
            if (colormemDifficulty === 'medium') return 500;
            return 350;
        }
        function initColormemBoard() {
            colormemBoard.innerHTML = '';
            const count = getColormemColorCount();
            let cols = count === 4 ? 2 : 3;
            colormemBoard.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;
            for (let i = 0; i < count; i++) {
                const tile = document.createElement('div');
                tile.className = 'colormem-tile';
                tile.style.background = COLORMEM_COLORS[i].color;
                tile.style.color = COLORMEM_COLORS[i].color;
                tile.addEventListener('click', () => handleColormemClick(i));
                colormemBoard.appendChild(tile);
            }
        }
        function clearColormemTimeouts() { colormemTimeouts.forEach(tt => clearTimeout(tt)); colormemTimeouts = []; }
        function flashColormemTile(idx, duration = 400) {
            const tile = colormemBoard.children[idx];
            if (!tile) return;
            tile.classList.add('lit');
            const tt = setTimeout(() => tile.classList.remove('lit'), duration);
            colormemTimeouts.push(tt);
        }
        function playColormemSequence() {
            colormemAccepting = false;
            const tiles = colormemBoard.querySelectorAll('.colormem-tile');
            tiles.forEach(t => t.classList.add('disabled'));
            colormemStatusEl.textContent = '👀';
            colormemLog.innerHTML = '<p>' + t('colormemWatch') + '</p>';
            const speed = getColormemSpeed();
            colormemSequence.forEach((colorIdx, i) => {
                const tt = setTimeout(() => { flashColormemTile(colorIdx, speed * 0.6); }, i * speed);
                colormemTimeouts.push(tt);
            });
            const tt = setTimeout(() => {
                tiles.forEach(t => t.classList.remove('disabled'));
                colormemAccepting = true; colormemPlayerIndex = 0;
                colormemStatusEl.textContent = t('colormemYourTurn');
                colormemLog.innerHTML = '<p>' + t('colormemYourTurn') + '</p>';
            }, colormemSequence.length * speed + 400);
            colormemTimeouts.push(tt);
        }
        function startColormemGame() {
            if (colormemPlaying) return;
            clearColormemTimeouts();
            colormemSequence = []; colormemPlayerIndex = 0;
            colormemRound = 0; colormemScore = 0;
            colormemRoundEl.textContent = '0'; colormemScoreEl.textContent = '0';
            colormemPlaying = true; colormemAccepting = false;
            colormemLog.innerHTML = '<p>🎵</p>';
            nextColormemRound();
        }
        function nextColormemRound() {
            colormemRound++; colormemRoundEl.textContent = colormemRound;
            const colorCount = getColormemColorCount();
            colormemSequence.push(Math.floor(Math.random() * colorCount));
            playColormemSequence();
        }
        function handleColormemClick(idx) {
            if (!colormemAccepting || !colormemPlaying) return;
            flashColormemTile(idx, 250);
            if (idx === colormemSequence[colormemPlayerIndex]) {
                colormemPlayerIndex++;
                if (colormemPlayerIndex === colormemSequence.length) {
                    colormemAccepting = false;
                    colormemScore += colormemRound;
                    colormemScoreEl.textContent = colormemScore;
                    colormemStatusEl.textContent = '✅';
                    SFX.colormemCorrect();
                    colormemLog.innerHTML = '<p>' + t('colormemCorrect') + '</p>';
                    if (colormemRound > colormemBest) { colormemBest = colormemRound; colormemBestEl.textContent = colormemBest; }
                    const tt = setTimeout(() => { if (colormemPlaying) nextColormemRound(); }, 1000);
                    colormemTimeouts.push(tt);
                }
            } else {
                colormemPlaying = false; colormemAccepting = false;
                colormemStatusEl.textContent = '❌';
                SFX.colormemWrong();
                colormemLog.innerHTML = '<p>' + t('colormemWrong') + ' ' + colormemRound + '</p>';
                if (colormemRound > colormemBest) {
                    colormemBest = colormemRound; colormemBestEl.textContent = colormemBest;
                    colormemLog.innerHTML += '<p>🏆 ' + t('colormemNewBest') + '</p>';
                }
                colormemBoard.querySelectorAll('.colormem-tile').forEach(t => t.classList.add('disabled'));
            }
        }
        colormemStartBtn.addEventListener('click', () => { SFX.click(); startColormemGame(); });
        colormemResetBtn.addEventListener('click', () => {
            SFX.click(); clearColormemTimeouts();
            colormemSequence = []; colormemPlayerIndex = 0;
            colormemRound = 0; colormemPlaying = false; colormemAccepting = false;
            colormemRoundEl.textContent = '0'; colormemStatusEl.textContent = t('ready');
            colormemLog.innerHTML = '<p>' + t('colormemHint') + '</p>';
            initColormemBoard();
        });
        initColormemBoard();

        // 初始化语言
        applyLanguage();

        // 清理
        window.addEventListener('beforeunload', () => {
            if (aiGuessInterval) clearInterval(aiGuessInterval);
            if (memoryTimer) clearInterval(memoryTimer);
            if (sortTimer) clearInterval(sortTimer);
            if (reactionTimer) clearTimeout(reactionTimer);
            if (whackTimer) clearInterval(whackTimer);
            if (whackSpawnTimer) clearInterval(whackSpawnTimer);
            clearSimonTimeouts();
            clearColormemTimeouts();
        });

    })();
</script>
</body>
</html>
