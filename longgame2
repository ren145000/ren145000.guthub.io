        function getSortCount() {
            if (sortDifficulty === 'easy') return 4;
            if (sortDifficulty === 'medium') return 6;
            return 8;
        }
        function initSortNumberGame() {
            if (sortTimer) clearInterval(sortTimer);
            sortTimer = null; sortSeconds = 0; sortCorrect = 0; sortWrong = 0; sortLevel = 0; sortPlaying = false;
            sortNumbers = []; sortExpectedIndex = 0;
            sortCorrectEl.textContent = '0'; sortWrongEl.textContent = '0'; sortTimeEl.textContent = '0s';
            sortLevelEl.textContent = '0';
            sortInstruction.textContent = t('sortInstruction');
            sortLog.innerHTML = '<p>' + t('sortHint') + '</p>';
            renderSortBoard();
        }
        function renderSortBoard() {
            sortNumberBoard.innerHTML = '';
            sortNumbers.forEach((num, idx) => {
                const item = document.createElement('div');
                item.className = 'sortnumber-item';
                if (num.correct) item.classList.add('correct');
                item.textContent = num.value;
                item.addEventListener('click', () => handleSortNumberClick(idx));
                sortNumberBoard.appendChild(item);
            });
        }
        function startSortLevel() {
            sortLevel++; sortLevelEl.textContent = sortLevel;
            const count = getSortCount();
            const offset = sortLevel * 2;
            const nums = [];
            for (let i = 0; i < count; i++) nums.push(offset + i + 1);
            for (let i = nums.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [nums[i], nums[j]] = [nums[j], nums[i]]; }
            sortNumbers = nums.map(v => ({ value: v, correct: false }));
            sortExpectedIndex = 0; sortPlaying = true;
            sortInstruction.textContent = t('sortInstruction') + ` (${sortExpectedIndex + 1}/${sortNumbers.length})`;
            renderSortBoard();
        }
        function handleSortNumberClick(idx) {
            if (!sortPlaying) return;
            const item = sortNumbers[idx];
            if (item.correct) return;
            const sortedValues = [...sortNumbers].map(n => n.value).sort((a, b) => a - b);
            const expectedValue = sortedValues[sortExpectedIndex];
            if (item.value === expectedValue) {
                item.correct = true; sortCorrect++; sortCorrectEl.textContent = sortCorrect; SFX.sortCorrect();
                sortExpectedIndex++;
                sortInstruction.textContent = t('sortInstruction') + ` (${sortExpectedIndex + 1}/${sortNumbers.length})`;
                renderSortBoard();
                if (sortExpectedIndex === sortNumbers.length) {
                    sortPlaying = false; SFX.win();
                    setTimeout(() => { if (!sortPlaying) startSortLevel(); }, 1000);
