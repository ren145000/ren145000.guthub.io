        }
        function updateReactionStats() {
            reactionAttemptsEl.textContent = reactionAttempts;
            if (reactionBest !== Infinity) reactionBestEl.textContent = reactionBest.toFixed(0) + 'ms';
            if (reactionTimes.length > 0) {
                reactionLastEl.textContent = reactionTimes[reactionTimes.length - 1].toFixed(0) + 'ms';
