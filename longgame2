        let sortNumbers = [], sortExpectedIndex = 0, sortPlaying = false, sortLevel = 0, sortCorrect = 0, sortWrong = 0;
        let sortTimer = null, sortSeconds = 0, sortDifficulty = 'easy';

        sortDiffBtns.forEach(btn => {
