<!DOCTYPE html>
<html lang="zh">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-i18n="title">龙龙游戏厅2 · AI版</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
        body {
            background: linear-gradient(145deg, #1a1e2b 0%, #2b2f42 100%);
            min-height: 100vh; display: flex; justify-content: center; align-items: center;
            font-family: 'Segoe UI', Roboto, system-ui, sans-serif; padding: 16px;
        }
        .gamehall {
            max-width: 1100px; width: 100%;
            background: rgba(22, 26, 35, 0.85); backdrop-filter: blur(10px);
            border-radius: 3.5rem; padding: 30px 28px;
            box-shadow: 0 30px 40px rgba(0, 0, 0, 0.6), inset 0 1px 4px rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(120, 160, 255, 0.2);
        }
        h1 {
            font-size: 2.4rem; font-weight: 700; letter-spacing: 2px; text-align: center;
            color: #dfe7ff; text-shadow: 0 0 10px #4466ff, 0 4px 8px black;
            margin-bottom: 12px; display: flex; align-items: center; justify-content: center; gap: 12px;
        }
        h1 span {
            background: #2e3a5e; font-size: 1.4rem; padding: 0 16px; border-radius: 60px;
            border: 1px solid #6a8aff; color: #b7cbff; font-weight: 400; letter-spacing: 1px;
        }
        .tabs {
            display: flex; gap: 8px; margin-bottom: 24px; padding: 6px;
            background: #10141f; border-radius: 80px; border: 1px solid #31405e; flex-wrap: wrap;
        }
        .tab-btn {
            flex: 1; padding: 12px 8px; border: none; background: transparent;
            color: #8e9ed4; font-weight: 600; font-size: 0.85rem; border-radius: 60px;
            cursor: pointer; transition: all 0.2s; letter-spacing: 0.5px;
            display: flex; align-items: center; justify-content: center; gap: 6px; white-space: nowrap;
        }
        .tab-btn.active {
            background: #2f3c62; color: #eef3ff;
            box-shadow: 0 0 12px #3e5eff, inset 0 1px 2px rgba(255, 255, 255, 0.2);
            border: 1px solid #7592ff;
        }
        .game-panel { display: none; animation: fade 0.3s ease; }
        .game-panel.active { display: block; }
        @keyframes fade { from { opacity: 0.5; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

        .btn {
            background: #28365a; border: none; border-radius: 60px; padding: 16px 32px;
            font-weight: 700; font-size: 1.1rem; color: #e9f0ff; cursor: pointer;
            transition: all 0.15s; border-bottom: 4px solid #0e1422;
            letter-spacing: 0.8px; box-shadow: 0 4px 12px #00000044;
        }
        .btn:hover:not(:disabled) { background: #364b7a; transform: scale(1.02); }
        .btn:active:not(:disabled) { transform: translateY(2px); border-bottom-width: 2px; }
        .btn:disabled { opacity: 0.4; cursor: not-allowed; border-bottom-width: 4px; }
        .btn-primary { background: #3d5a9b; border-bottom-color: #1b2a4a; }
        .btn-primary:hover:not(:disabled) { background: #4f72bd; }
        .reset-btn { background: #2c3145; border-bottom-color: #151a28; padding: 14px 28px; font-size: 1rem; }

        .lang-switch { display: flex; gap: 6px; justify-content: center; margin-bottom: 18px; flex-wrap: wrap; }
        .lang-btn {
            padding: 8px 20px; border-radius: 40px; border: 1px solid #334877;
            background: #101624; color: #8da3da; font-weight: 600; font-size: 0.9rem;
            cursor: pointer; transition: 0.15s;
        }
        .lang-btn:hover { background: #1a233b; }
        .lang-btn.active {
            background: #30416b; color: #f0f5ff;
            box-shadow: 0 0 16px #5272ff; border-color: #7592ff;
        }

        .sound-toggle {
            position: fixed; top: 20px; right: 20px;
            background: #1e2640; border: 1px solid #4f6dbb; color: #dfe9ff;
            border-radius: 50px; padding: 10px 18px; font-size: 1.2rem;
            cursor: pointer; z-index: 999; box-shadow: 0 4px 12px #00000066; transition: 0.2s;
        }
        .sound-toggle:hover { background: #2f3c62; }

        /* 数字炸弹 */
        .bomb-area { display: flex; flex-direction: column; gap: 24px; }
        .range-banner {
            background: #0c101b; border-radius: 100px; padding: 14px 28px;
            display: flex; justify-content: space-between; align-items: center;
            border: 1px solid #364a7a; box-shadow: inset 0 0 18px #00000055;
        }
        .range-text { font-size: 1.8rem; font-weight: 800; color: #b7d0ff; text-shadow: 0 0 12px #3e6eff; }
        .range-text small { font-size: 1rem; color: #8096c0; margin-left: 12px; font-weight: 400; }
        .bomb-info { display: flex; align-items: center; gap: 12px; }
        .bomb-icon { font-size: 2.2rem; filter: drop-shadow(0 0 12px #ffaa33); }
        .turn-indicator {
            background: #1e2640; padding: 10px 24px; border-radius: 60px;
            font-weight: 600; color: #dfe9ff; border: 1px solid #4f6dbb;
            font-size: 1.1rem; letter-spacing: 1px; box-shadow: 0 0 18px #2f4cff44;
        }
        .players-row { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
        .player-card {
            background: #131a2b; border: 2px solid #2b3e66; border-radius: 28px;
            padding: 18px 22px; width: 160px; text-align: center;
            transition: all 0.25s; box-shadow: 0 8px 0 #0a0e16;
        }
        .player-card.active-turn {
            border-color: #ffe066; box-shadow: 0 0 24px #ffbb33, 0 8px 0 #0a0e16;
            transform: translateY(-2px); background: #1a233b;
        }
        .player-avatar { font-size: 2.8rem; margin-bottom: 6px; }
        .player-name { font-weight: 700; color: #d3e2ff; font-size: 1.2rem; letter-spacing: 0.5px; }
        .player-status {
            font-size: 0.9rem; color: #7d93c4; margin-top: 6px;
            background: #0e1422; padding: 5px 0; border-radius: 40px;
        }
        .history-panel {
            background: #0b0f1a; border-radius: 50px; padding: 12px 24px;
            display: flex; flex-wrap: wrap; gap: 10px; align-items: center;
            min-height: 64px; border: 1px solid #27375a;
        }
        .history-label { color: #6a80b0; font-weight: 600; font-size: 1rem; margin-right: 6px; }
        .guess-badge {
            background: #1c2742; padding: 6px 16px; border-radius: 30px;
            font-weight: 600; color: #b8ceff; border: 1px solid #3d5590; font-size: 0.95rem;
        }
        .bomb-input-area { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; justify-content: center; }
        .bomb-input-area input {
            background: #0c1120; border: 2px solid #2e4070; border-radius: 60px;
            padding: 18px 26px; font-size: 1.3rem; width: 160px; color: #ebf2ff;
            font-weight: 600; outline: none; text-align: center; transition: 0.2s;
        }
        .bomb-input-area input:focus { border-color: #6d93ff; box-shadow: 0 0 18px #3d6eff; }
        .message-bar { text-align: center; font-weight: 500; color: #a5b9e6; min-height: 28px; }

        /* 你画我猜 */
        .draw-area { display: flex; flex-direction: column; gap: 22px; }
        .canvas-container {
            display: flex; justify-content: center; background: #0e1321;
            padding: 14px; border-radius: 40px; border: 2px solid #273a62;
            box-shadow: inset 0 0 30px #00000080; flex-wrap: wrap; gap: 16px; align-items: flex-start;
        }
        .canvas-wrapper { position: relative; }
        canvas {
            background: #fbfdff; border-radius: 30px; width: 100%; max-width: 500px;
            height: auto; aspect-ratio: 1/1; box-shadow: 0 0 0 2px #3c5a9e, 0 16px 30px black;
            cursor: crosshair; touch-action: none; display: block;
        }
        .tool-panel {
            display: flex; flex-direction: column; gap: 16px;
            background: #101624; border-radius: 30px; padding: 20px;
            border: 1px solid #334877; min-width: 160px;
        }
        .tool-label { color: #8da3da; font-weight: 600; font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase; }
        .color-palette { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
        .color-swatch {
            width: 36px; height: 36px; border-radius: 50%; cursor: pointer;
            border: 3px solid transparent; transition: all 0.15s; box-shadow: 0 2px 6px #00000066;
        }
        .color-swatch:hover { transform: scale(1.15); }
        .color-swatch.active { border-color: #ffd966; box-shadow: 0 0 12px #ffd966; transform: scale(1.1); }
        .brush-sizes { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
        .brush-size-btn {
            width: 40px; height: 40px; border-radius: 50%; border: 2px solid #334877;
            background: #0b101d; cursor: pointer; display: flex; align-items: center;
            justify-content: center; transition: all 0.15s;
        }
        .brush-size-btn:hover { background: #1a233b; }
        .brush-size-btn.active { border-color: #ffd966; box-shadow: 0 0 12px #ffd966; background: #1a233b; }
        .brush-dot { border-radius: 50%; background: #e0e8ff; }
        .canvas-controls { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; align-items: center; }
        .role-switch { display: flex; background: #101624; border-radius: 60px; padding: 6px; border: 1px solid #334877; }
        .role-btn {
            padding: 12px 28px; border-radius: 40px; border: none; background: transparent;
            color: #8da3da; font-weight: 600; font-size: 1.05rem; cursor: pointer; transition: 0.15s;
        }
        .role-btn.active { background: #30416b; color: #f0f5ff; box-shadow: 0 0 16px #5272ff; }
        .difficulty-switch {
            display: flex; gap: 8px; background: #101624; border-radius: 60px;
            padding: 6px; border: 1px solid #334877;
        }
        .diff-btn {
            padding: 10px 22px; border-radius: 40px; border: none; background: transparent;
            color: #8da3da; font-weight: 600; font-size: 0.95rem; cursor: pointer; transition: 0.15s;
        }
        .diff-btn.active { background: #30416b; color: #f0f5ff; box-shadow: 0 0 16px #5272ff; }
        .diff-btn.easy.active { background: #2d6a4f; box-shadow: 0 0 16px #40916c; }
        .diff-btn.medium.active { background: #b8860b; box-shadow: 0 0 16px #ffaa33; }
        .diff-btn.hard.active { background: #9b2226; box-shadow: 0 0 16px #ff3b3b; }
        .ai-guess-bubble {
            background: #1a253e; border-radius: 40px; padding: 14px 26px;
            display: flex; align-items: center; gap: 20px;
            border: 1px solid #3f5a9b; box-shadow: 0 0 20px #223c77;
        }
        .ai-guess-bubble .ai-icon { font-size: 2.2rem; }
        .ai-guess-text { font-size: 1.3rem; color: #e5edff; font-weight: 600; letter-spacing: 0.5px; }
        .ai-guess-text span { color: #ffd966; font-size: 1.6rem; margin-left: 8px; text-shadow: 0 0 12px #ffaa33; }
        .guess-input-area { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; justify-content: center; }
        .guess-input-area input {
            background: #0b101d; border: 2px solid #2e4070; border-radius: 60px;
            padding: 16px 24px; font-size: 1.2rem; width: 220px; color: #ebf2ff;
            font-weight: 600; outline: none; text-align: center;
        }
        .guess-input-area input:focus { border-color: #6d93ff; box-shadow: 0 0 18px #3d6eff; }
        .secret-word-badge {
            background: #262f4a; padding: 8px 20px; border-radius: 40px;
            font-size: 1.1rem; color: #cad8ff;
        }
        .secret-word-badge strong { color: #fff0b5; margin-left: 8px; font-size: 1.3rem; }
        .flex-row { display: flex; gap: 16px; align-items: center; justify-content: center; flex-wrap: wrap; }

        /* 猜数字 */
        .guess-number-area { display: flex; flex-direction: column; gap: 24px; align-items: center; }
        .guess-number-header { font-size: 1.3rem; color: #b7cbff; font-weight: 600; text-align: center; }
        .guess-number-display {
            background: #101624; border-radius: 32px; padding: 32px 48px;
            border: 2px solid #2b3e66; box-shadow: 0 8px 0 #0a0e16;
            text-align: center; width: 100%; max-width: 400px;
        }
        .guess-number-display .ai-avatar { font-size: 3.5rem; }
        .guess-number-display .ai-name { font-weight: 700; color: #d3e2ff; font-size: 1.3rem; margin: 8px 0; }
        .guess-number-display .range-hint {
            font-size: 1.6rem; font-weight: 800; color: #ffd966;
            text-shadow: 0 0 20px #ffaa33; background: #0b0f1a; border-radius: 20px;
            padding: 16px; margin: 12px 0; border: 1px solid #3d5590;
        }
        .guess-number-display .feedback { font-size: 1.1rem; color: #a5b9e6; font-weight: 600; min-height: 28px; }
        .guess-number-input-area { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; justify-content: center; }
        .guess-number-input-area input {
            background: #0c1120; border: 2px solid #2e4070; border-radius: 60px;
            padding: 18px 26px; font-size: 1.3rem; width: 180px; color: #ebf2ff;
            font-weight: 600; outline: none; text-align: center; transition: 0.2s;
        }
        .guess-number-input-area input:focus { border-color: #6d93ff; box-shadow: 0 0 18px #3d6eff; }
        .guess-number-log {
            background: #0b0f1a; border-radius: 30px; padding: 20px;
            width: 100%; max-width: 500px; min-height: 100px;
            border: 1px solid #27375a; color: #c0d0f0; font-size: 1rem;
            line-height: 1.8; overflow-y: auto; max-height: 180px;
        }

        /* 五子棋 */
        .gomoku-area { display: flex; flex-direction: column; gap: 20px; align-items: center; }
        .gomoku-board-wrapper {
            background: #0e1321; padding: 20px; border-radius: 40px;
            border: 2px solid #273a62; box-shadow: inset 0 0 30px #00000080; display: inline-block;
        }
        .gomoku-board {
            display: grid; grid-template-columns: repeat(9, 1fr); gap: 2px;
            background: #d4a373; padding: 8px; border-radius: 20px; box-shadow: 0 16px 30px black;
        }
        .gomoku-cell {
            width: 48px; height: 48px; background: #f0d5b0; border-radius: 6px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.8rem; cursor: pointer; transition: all 0.1s; border: 1px solid #c49a6c;
        }
        .gomoku-cell:hover { background: #ffe4c4; transform: scale(1.05); }
        .gomoku-cell.black { color: #1a1a2e; }
        .gomoku-cell.white { color: #ffffff; text-shadow: 0 0 4px #000; }
        .gomoku-cell.win { background: #ffe066; box-shadow: 0 0 16px #ffaa33; }
        .gomoku-info { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; justify-content: center; }
        .gomoku-turn {
            background: #1e2640; padding: 12px 28px; border-radius: 60px;
            font-weight: 600; color: #dfe9ff; border: 1px solid #4f6dbb;
            font-size: 1.15rem; letter-spacing: 1px;
        }
        .gomoku-score {
            background: #131a2b; border-radius: 40px; padding: 10px 24px;
            border: 1px solid #2b3e66; font-weight: 600; color: #cad8ff;
        }

        /* 记忆翻牌 */
        .memory-area { display: flex; flex-direction: column; gap: 20px; align-items: center; }
        .memory-info { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; justify-content: center; }
        .memory-stat {
            background: #1e2640; padding: 12px 28px; border-radius: 60px;
            font-weight: 600; color: #dfe9ff; border: 1px solid #4f6dbb; font-size: 1.1rem;
        }
        .memory-stat strong { color: #ffd966; font-size: 1.3rem; margin-left: 6px; }
        .memory-board {
            display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;
            background: #0e1321; padding: 20px; border-radius: 40px;
            border: 2px solid #273a62; box-shadow: inset 0 0 30px #00000080;
        }
        .memory-card {
            width: 80px; height: 80px; border-radius: 16px;
            background: linear-gradient(135deg, #2f3c62, #1a233b);
            border: 2px solid #3d5590; display: flex; align-items: center;
            justify-content: center; font-size: 2.2rem; cursor: pointer;
            transition: all 0.25s; box-shadow: 0 4px 8px #00000066; transform-style: preserve-3d;
        }
        .memory-card:hover:not(.matched) { transform: scale(1.06); border-color: #7592ff; box-shadow: 0 0 16px #5272ff; }
        .memory-card.flipped { background: linear-gradient(135deg, #30416b, #1a233b); border-color: #ffd966; box-shadow: 0 0 16px #ffaa33; }
        .memory-card.matched { background: linear-gradient(135deg, #2d6a4f, #1a3d2b); border-color: #40916c; box-shadow: 0 0 16px #40916c; cursor: default; opacity: 0.85; }
        .memory-card .card-face { display: flex; align-items: center; justify-content: center; font-size: 2.2rem; }
        .memory-log {
            background: #0b0f1a; border-radius: 30px; padding: 16px 24px;
            width: 100%; max-width: 500px; min-height: 60px;
            border: 1px solid #27375a; color: #c0d0f0; font-size: 0.95rem;
            line-height: 1.7; overflow-y: auto; max-height: 140px;
        }

        /* 井字棋 */
        .tictactoe-area { display: flex; flex-direction: column; gap: 20px; align-items: center; }
        .tictactoe-info { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; justify-content: center; }
        .tictactoe-board {
            display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;
            background: #0e1321; padding: 16px; border-radius: 32px;
            border: 2px solid #273a62; box-shadow: inset 0 0 30px #00000080;
        }
        .tictactoe-cell {
            width: 100px; height: 100px; background: #1a233b; border-radius: 16px;
            display: flex; align-items: center; justify-content: center;
            font-size: 3rem; font-weight: 900; cursor: pointer;
            transition: all 0.15s; border: 2px solid #2b3e66; color: #e5edff;
        }
        .tictactoe-cell:hover:not(.taken) { background: #2a3a5a; border-color: #7592ff; transform: scale(1.04); }
        .tictactoe-cell.taken { cursor: not-allowed; }
        .tictactoe-cell.x { color: #4fc3f7; text-shadow: 0 0 20px #4fc3f7; }
        .tictactoe-cell.o { color: #ff8a65; text-shadow: 0 0 20px #ff8a65; }
        .tictactoe-cell.win { background: #2d6a4f; border-color: #40916c; box-shadow: 0 0 20px #40916c; }
        .tictactoe-score {
            background: #1e2640; padding: 12px 28px; border-radius: 60px;
            font-weight: 600; color: #dfe9ff; border: 1px solid #4f6dbb; font-size: 1.1rem;
        }
        .tictactoe-score strong { color: #ffd966; font-size: 1.3rem; margin-left: 6px; }
        .tictactoe-log {
            background: #0b0f1a; border-radius: 30px; padding: 16px 24px;
            width: 100%; max-width: 400px; min-height: 50px;
            border: 1px solid #27375a; color: #c0d0f0; font-size: 0.95rem;
            line-height: 1.7; overflow-y: auto; max-height: 100px;
        }

        /* Simon Says —— 支持2/3/4颜色动态布局 */
        .simon-area { display: flex; flex-direction: column; gap: 24px; align-items: center; }
        .simon-info { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; justify-content: center; }
        .simon-stat {
            background: #1e2640; padding: 12px 28px; border-radius: 60px;
            font-weight: 600; color: #dfe9ff; border: 1px solid #4f6dbb; font-size: 1.1rem;
        }
        .simon-stat strong { color: #ffd966; font-size: 1.3rem; margin-left: 6px; }
        .simon-board {
            display: grid; gap: 14px;
            background: #0e1321; padding: 20px; border-radius: 40px;
            border: 2px solid #273a62; box-shadow: inset 0 0 30px #00000080;
            justify-items: center;
        }
        /* 2×2 布局（简单：4色） */
        .simon-board.cols-2 { grid-template-columns: repeat(2, 1fr); }
        /* 3×1 布局（中等：3色） */
        .simon-board.cols-3 { grid-template-columns: repeat(3, 1fr); }
        /* 2×2 布局（困难：4色+更小） */
        .simon-btn {
            width: 140px; height: 140px; border-radius: 24px; cursor: pointer;
            transition: all 0.12s; border: 4px solid transparent; opacity: 0.7;
        }
        .simon-btn:active { transform: scale(0.95); }
        .simon-btn.green { background: #2ecc71; }
        .simon-btn.red { background: #e74c3c; }
        .simon-btn.yellow { background: #f1c40f; }
        .simon-btn.blue { background: #3498db; }
        .simon-btn.lit { opacity: 1; border-color: #fff; box-shadow: 0 0 40px currentColor; transform: scale(1.05); }
        .simon-btn.green.lit { box-shadow: 0 0 50px #2ecc71; }
        .simon-btn.red.lit { box-shadow: 0 0 50px #e74c3c; }
        .simon-btn.yellow.lit { box-shadow: 0 0 50px #f1c40f; }
        .simon-btn.blue.lit { box-shadow: 0 0 50px #3498db; }
        .simon-btn.disabled { pointer-events: none; opacity: 0.35; }
        .simon-log {
            background: #0b0f1a; border-radius: 30px; padding: 16px 24px;
            width: 100%; max-width: 500px; min-height: 60px;
            border: 1px solid #27375a; color: #c0d0f0; font-size: 0.95rem;
            line-height: 1.7; overflow-y: auto; max-height: 120px;
        }

        /* AI数字排序 */
        .sortnumber-area { display: flex; flex-direction: column; gap: 20px; align-items: center; }
        .sortnumber-info { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; justify-content: center; }
        .sortnumber-stat {
            background: #1e2640; padding: 12px 28px; border-radius: 60px;
            font-weight: 600; color: #dfe9ff; border: 1px solid #4f6dbb; font-size: 1.1rem;
        }
        .sortnumber-stat strong { color: #ffd966; font-size: 1.3rem; margin-left: 6px; }
        .sortnumber-board {
            display: flex; gap: 16px; flex-wrap: wrap; justify-content: center;
            background: #0e1321; padding: 24px; border-radius: 40px;
            border: 2px solid #273a62; box-shadow: inset 0 0 30px #00000080;
            min-height: 140px; align-items: center;
        }
        .sortnumber-item {
            width: 90px; height: 90px; border-radius: 20px;
            background: linear-gradient(135deg, #2f3c62, #1a233b);
            border: 2px solid #3d5590; display: flex; align-items: center;
            justify-content: center; font-size: 2rem; font-weight: 800;
            color: #ffd966; cursor: pointer; transition: all 0.2s;
            box-shadow: 0 4px 8px #00000066; text-shadow: 0 0 12px #ffaa33;
        }
        .sortnumber-item:hover { border-color: #7592ff; transform: translateY(-4px); }
        .sortnumber-item.selected {
            border-color: #ffd966; box-shadow: 0 0 24px #ffaa33;
            background: linear-gradient(135deg, #3d5a9b, #2a3d6b); transform: scale(1.05);
        }
        .sortnumber-item.correct {
            background: linear-gradient(135deg, #2d6a4f, #1a3d2b);
            border-color: #40916c; box-shadow: 0 0 20px #40916c;
        }
        .sortnumber-item.wrong {
            background: linear-gradient(135deg, #9b2226, #5f1518);
            border-color: #e74c3c; box-shadow: 0 0 20px #e74c3c;
        }
        .sortnumber-log {
            background: #0b0f1a; border-radius: 30px; padding: 16px 24px;
            width: 100%; max-width: 600px; min-height: 60px;
            border: 1px solid #27375a; color: #c0d0f0; font-size: 0.95rem;
            line-height: 1.7; overflow-y: auto; max-height: 120px;
        }

        /* AI反应力 */
        .reaction-area { display: flex; flex-direction: column; gap: 20px; align-items: center; }
        .reaction-info { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; justify-content: center; }
        .reaction-stat {
            background: #1e2640; padding: 12px 28px; border-radius: 60px;
            font-weight: 600; color: #dfe9ff; border: 1px solid #4f6dbb; font-size: 1.1rem;
        }
        .reaction-stat strong { color: #ffd966; font-size: 1.3rem; margin-left: 6px; }
        .reaction-target {
            width: 100%; max-width: 600px; height: 300px;
            border-radius: 40px; border: 3px solid #273a62;
            background: #0e1321; display: flex; align-items: center;
            justify-content: center; font-size: 2rem; font-weight: 800;
            color: #cad8ff; cursor: pointer; transition: all 0.2s;
            box-shadow: inset 0 0 30px #00000080; text-align: center;
            padding: 20px;
        }
        .reaction-target.waiting { background: #1a233b; color: #8da3da; }
        .reaction-target.ready { background: #e74c3c; color: #fff; box-shadow: 0 0 60px #e74c3c, inset 0 0 30px #00000080; }
        .reaction-target.go { background: #2ecc71; color: #fff; box-shadow: 0 0 60px #2ecc71, inset 0 0 30px #00000080; }
        .reaction-target.toosoon { background: #f39c12; color: #fff; box-shadow: 0 0 60px #f39c12, inset 0 0 30px #00000080; }
        .reaction-log {
            background: #0b0f1a; border-radius: 30px; padding: 16px 24px;
            width: 100%; max-width: 600px; min-height: 60px;
            border: 1px solid #27375a; color: #c0d0f0; font-size: 0.95rem;
            line-height: 1.7; overflow-y: auto; max-height: 120px;
        }

        /* AI打地鼠 */
        .whack-area { display: flex; flex-direction: column; gap: 20px; align-items: center; }
        .whack-info { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; justify-content: center; }
        .whack-stat {
            background: #1e2640; padding: 12px 28px; border-radius: 60px;
            font-weight: 600; color: #dfe9ff; border: 1px solid #4f6dbb; font-size: 1.1rem;
        }
        .whack-stat strong { color: #ffd966; font-size: 1.3rem; margin-left: 6px; }
        .whack-board {
            display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
            background: #0e1321; padding: 24px; border-radius: 40px;
            border: 2px solid #273a62; box-shadow: inset 0 0 30px #00000080;
        }
        .whack-hole {
            width: 100px; height: 100px; border-radius: 50%;
            background: radial-gradient(circle at center, #1a233b 0%, #0a0e16 100%);
            border: 3px solid #2b3e66; position: relative;
            cursor: pointer; overflow: hidden; transition: all 0.15s;
        }
        .whack-hole:hover { border-color: #7592ff; }
        .whack-mole {
            position: absolute; top: 100%; left: 50%;
            transform: translateX(-50%); width: 80%; height: 80%;
            border-radius: 50%; background: radial-gradient(circle at 30% 30%, #f4a261, #8b5a2b);
            display: flex; align-items: center; justify-content: center;
            font-size: 2.5rem; transition: top 0.15s ease-out;
            box-shadow: 0 4px 12px #00000088;
        }
        .whack-mole.up { top: 10%; }
        .whack-mole.hit { background: radial-gradient(circle at 30% 30%, #e74c3c, #8b1a1a); }
        .whack-log {
            background: #0b0f1a; border-radius: 30px; padding: 16px 24px;
            width: 100%; max-width: 600px; min-height: 60px;
            border: 1px solid #27375a; color: #c0d0f0; font-size: 0.95rem;
            line-height: 1.7; overflow-y: auto; max-height: 120px;
        }

        /* AI猜拳 */
        .rps-area { display: flex; flex-direction: column; gap: 24px; align-items: center; }
        .rps-info { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; justify-content: center; }
        .rps-stat {
            background: #1e2640; padding: 12px 28px; border-radius: 60px;
            font-weight: 600; color: #dfe9ff; border: 1px solid #4f6dbb; font-size: 1.1rem;
        }
        .rps-stat strong { color: #ffd966; font-size: 1.3rem; margin-left: 6px; }
        .rps-arena {
            display: flex; gap: 40px; align-items: center; justify-content: center;
            flex-wrap: wrap; background: #0e1321; padding: 30px;
            border-radius: 40px; border: 2px solid #273a62;
            box-shadow: inset 0 0 30px #00000080; width: 100%; max-width: 700px;
        }
        .rps-side {
            flex: 1; min-width: 200px; text-align: center; padding: 20px;
            background: #101624; border-radius: 24px; border: 2px solid #2b3e66;
        }
        .rps-side .rps-avatar { font-size: 4rem; transition: all 0.3s; }
        .rps-side .rps-name { font-weight: 700; color: #d3e2ff; font-size: 1.2rem; margin: 8px 0; }
        .rps-side .rps-choice { font-size: 3.5rem; font-weight: 800; min-height: 60px; color: #ffd966; text-shadow: 0 0 20px #ffaa33; }
        .rps-vs { font-size: 2.5rem; font-weight: 900; color: #ff6b6b; text-shadow: 0 0 20px #ff3b3b; }
        .rps-buttons { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
        .rps-btn {
            width: 100px; height: 100px; border-radius: 24px;
            background: #1a233b; border: 2px solid #2b3e66;
            font-size: 3rem; cursor: pointer; transition: all 0.15s;
            display: flex; align-items: center; justify-content: center;
        }
        .rps-btn:hover:not(:disabled) { background: #2a3a5a; border-color: #7592ff; transform: scale(1.08); }
        .rps-btn:disabled { opacity: 0.4; cursor: not-allowed; }
        .rps-log {
            background: #0b0f1a; border-radius: 30px; padding: 16px 24px;
            width: 100%; max-width: 600px; min-height: 60px;
            border: 1px solid #27375a; color: #c0d0f0; font-size: 0.95rem;
            line-height: 1.7; overflow-y: auto; max-height: 120px;
        }

        /* AI颜色记忆 */
        .colormem-area { display: flex; flex-direction: column; gap: 20px; align-items: center; }
        .colormem-info { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; justify-content: center; }
        .colormem-stat {
            background: #1e2640; padding: 12px 28px; border-radius: 60px;
            font-weight: 600; color: #dfe9ff; border: 1px solid #4f6dbb; font-size: 1.1rem;
        }
        .colormem-stat strong { color: #ffd966; font-size: 1.3rem; margin-left: 6px; }
        .colormem-board {
            display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
            background: #0e1321; padding: 24px; border-radius: 40px;
            border: 2px solid #273a62; box-shadow: inset 0 0 30px #00000080;
        }
        .colormem-tile {
            width: 110px; height: 110px; border-radius: 20px;
            cursor: pointer; transition: all 0.2s;
            border: 4px solid transparent; opacity: 0.85;
            box-shadow: 0 4px 12px #00000066;
        }
        .colormem-tile:hover { transform: scale(1.05); opacity: 1; }
        .colormem-tile.lit {
            opacity: 1; transform: scale(1.08);
            border-color: #fff; box-shadow: 0 0 40px currentColor;
        }
        .colormem-tile.disabled { pointer-events: none; opacity: 0.4; }
        .colormem-log {
            background: #0b0f1a; border-radius: 30px; padding: 16px 24px;
            width: 100%; max-width: 600px; min-height: 60px;
            border: 1px solid #27375a; color: #c0d0f0; font-size: 0.95rem;
            line-height: 1.7; overflow-y: auto; max-height: 120px;
        }

        .footer-note { margin-top: 20px; text-align: center; font-size: 0.85rem; color: #54668a; }

        @media (max-width: 700px) {
            .canvas-container { flex-direction: column; align-items: center; }
            .tool-panel { flex-direction: row; flex-wrap: wrap; min-width: unset; justify-content: center; width: 100%; }
            .memory-card { width: 60px; height: 60px; font-size: 1.6rem; }
            .tictactoe-cell { width: 70px; height: 70px; font-size: 2rem; }
            .simon-btn { width: 100px; height: 100px; }
            .sortnumber-item { width: 60px; height: 60px; font-size: 1.4rem; }
            .reaction-target { height: 200px; font-size: 1.5rem; }
            .whack-hole { width: 70px; height: 70px; }
            .rps-btn { width: 70px; height: 70px; font-size: 2rem; }
            .colormem-tile { width: 80px; height: 80px; }
        }
    </style>
</head>
<body>
<button class="sound-toggle" id="soundToggle" title="开关音效">🔊</button>

<div class="gamehall">
    <h1 data-i18n="title">🐉 龙龙游戏厅2 <span data-i18n="titleSub">AI版</span></h1>

    <div class="lang-switch">
        <button class="lang-btn active" data-lang="zh">🇨🇳 中文</button>
        <button class="lang-btn" data-lang="en">🇬🇧 English</button>
        <button class="lang-btn" data-lang="ja">🇯🇵 日本語</button>
        <button class="lang-btn" data-lang="ko">🇰🇷 한국어</button>
    </div>

    <div class="tabs">
        <button class="tab-btn active" data-tab="bomb"><span data-i18n="tabBomb">💣 数字炸弹</span></button>
        <button class="tab-btn" data-tab="draw"><span data-i18n="tabDraw">🎨 你画我猜</span></button>
        <button class="tab-btn" data-tab="guessnumber"><span data-i18n="tabGuess">🔢 猜数字</span></button>
        <button class="tab-btn" data-tab="gomoku"><span data-i18n="tabGomoku">⚫ 五子棋</span></button>
        <button class="tab-btn" data-tab="memory"><span data-i18n="tabMemory">🃏 记忆翻牌</span></button>
        <button class="tab-btn" data-tab="tictactoe"><span data-i18n="tabTTT">⭕ 井字棋</span></button>
        <button class="tab-btn" data-tab="simon"><span data-i18n="tabSimon">🎵 Simon</span></button>
        <button class="tab-btn" data-tab="sortnumber"><span data-i18n="tabSortNumber">🔢 排序</span></button>
        <button class="tab-btn" data-tab="reaction"><span data-i18n="tabReaction">⚡ 反应</span></button>
        <button class="tab-btn" data-tab="whack"><span data-i18n="tabWhack">🐹 打地鼠</span></button>
        <button class="tab-btn" data-tab="rps"><span data-i18n="tabRPS">✊ 猜拳</span></button>
        <button class="tab-btn" data-tab="colormem"><span data-i18n="tabColorMem">🌈 颜色记忆</span></button>
    </div>

    <!-- 数字炸弹面板 -->
    <div id="bombPanel" class="game-panel active">
        <div class="bomb-area">
            <div class="range-banner">
                <div class="range-text">1 ~ 100 <small data-i18n="rangeLabel">范围</small></div>
                <div class="bomb-info">
                    <span class="bomb-icon">💣</span>
                    <div class="turn-indicator" id="bombTurnIndicator" data-i18n="playerTurn">玩家回合</div>
                </div>
            </div>
            <div class="players-row" id="bombPlayersRow">
                <div class="player-card" id="playerCardHuman">
                    <div class="player-avatar">🧑</div>
                    <div class="player-name" data-i18n="you">你</div>
                    <div class="player-status" id="humanStatus" data-i18n="waiting">等待</div>
                </div>
                <div class="player-card" id="playerCardAI1">
                    <div class="player-avatar">🤖</div>
                    <div class="player-name" data-i18n="aiYan">AI 小炎</div>
                    <div class="player-status" id="ai1Status" data-i18n="waiting">等待</div>
                </div>
                <div class="player-card" id="playerCardAI2">
                    <div class="player-avatar">🤖</div>
                    <div class="player-name" data-i18n="aiBing">AI 小冰</div>
                    <div class="player-status" id="ai2Status" data-i18n="waiting">等待</div>
                </div>
            </div>
            <div class="history-panel" id="bombHistory">
                <span class="history-label" data-i18n="guessHistory">📋 猜测记录:</span>
            </div>
            <div class="bomb-input-area">
                <input type="number" id="bombInput" min="1" max="100" placeholder="1-100" value="">
                <button class="btn btn-primary" id="bombGuessBtn" data-i18n="guessBomb">💥 猜炸弹</button>
                <button class="btn reset-btn" id="bombResetBtn" data-i18n="newGame">🔄 新游戏</button>
            </div>
            <div class="message-bar" id="bombMessage" data-i18n="bombHint">输入数字，猜中炸弹就输啦！</div>
        </div>
    </div>

    <!-- 你画我猜面板 -->
    <div id="drawPanel" class="game-panel">
        <div class="draw-area">
            <div class="flex-row" style="justify-content: space-between;">
                <div class="role-switch">
                    <button class="role-btn active" id="rolePlayerDraw" data-i18n="iDrawAIGuess">✏️ 我画 · AI猜</button>
                    <button class="role-btn" id="roleAIDraw" data-i18n="aiDrawIGuess">🤖 AI画 · 我猜</button>
                </div>
                <div class="difficulty-switch" id="difficultySwitch">
                    <button class="diff-btn easy active" data-diff="easy" data-i18n="easy">😊 简单</button>
                    <button class="diff-btn medium" data-diff="medium" data-i18n="medium">😐 中等</button>
                    <button class="diff-btn hard" data-diff="hard" data-i18n="hard">😈 困难</button>
                </div>
                <div class="secret-word-badge"><span data-i18n="drawWord">🎯 要画:</span> <strong id="secretWordSpan">苹果</strong></div>
            </div>
            <div class="canvas-container">
                <div class="canvas-wrapper"><canvas id="drawCanvas" width="500" height="500"></canvas></div>
                <div class="tool-panel" id="toolPanel">
                    <div><div class="tool-label" data-i18n="colors">🎨 颜色</div><div class="color-palette" id="colorPalette"></div></div>
                    <div><div class="tool-label" data-i18n="brushSize">🖌️ 粗细</div><div class="brush-sizes" id="brushSizes"></div></div>
                </div>
            </div>
            <div class="canvas-controls">
                <button class="btn reset-btn" id="clearCanvasBtn" data-i18n="clearCanvas">🧽 清空画板</button>
                <button class="btn" id="aiGuessTriggerBtn" style="display: none;" data-i18n="letAIGuess">🤖 让AI猜猜</button>
            </div>
            <div id="aiGuessBubble" class="ai-guess-bubble">
                <span class="ai-icon">🤖</span>
                <div class="ai-guess-text"><span data-i18n="aiGuess">AI 猜测:</span> <span id="aiGuessWord">？</span></div>
            </div>
            <div class="guess-input-area" id="humanGuessArea" style="display: none;">
                <input type="text" id="humanGuessInput" data-i18n-placeholder="guessPlaceholder" placeholder="输入你的猜测...">
                <button class="btn btn-primary" id="humanGuessSubmitBtn" data-i18n="submitGuess">✅ 猜！</button>
            </div>
            <div class="message-bar" id="drawMessage" data-i18n="drawHint">画出词语，让AI猜中吧！</div>
        </div>
    </div>

    <!-- 猜数字面板 -->
    <div id="guessnumberPanel" class="game-panel">
        <div class="guess-number-area">
            <div class="guess-number-header" data-i18n="guessNumHeader">🔢 猜数字 · AI想了一个1-100的数字，你来猜！</div>
            <div class="guess-number-display">
                <div class="ai-avatar">🤖</div>
                <div class="ai-name" data-i18n="aiBing">AI 小冰</div>
                <div class="range-hint" id="guessRangeHint">1 ~ 100</div>
                <div class="feedback" id="guessFeedback" data-i18n="guessNumHint">输入数字，AI会告诉你大了还是小了！</div>
            </div>
            <div class="guess-number-input-area">
                <input type="number" id="guessNumberInput" min="1" max="100" placeholder="1-100" value="">
                <button class="btn btn-primary" id="guessNumberBtn" data-i18n="guessBtn">🎯 猜！</button>
                <button class="btn reset-btn" id="guessNumberResetBtn" data-i18n="newGame">🔄 新游戏</button>
            </div>
            <div class="guess-number-log" id="guessNumberLog">
                <p data-i18n="guessNumStart">游戏开始！AI已经想好了一个数字，快来猜吧！</p>
            </div>
        </div>
    </div>

    <!-- 五子棋面板 -->
    <div id="gomokuPanel" class="game-panel">
        <div class="gomoku-area">
            <div class="gomoku-info">
                <div class="gomoku-turn" id="gomokuTurnIndicator" data-i18n="yourTurnBlack">⚫ 你的回合 (黑棋)</div>
                <div class="gomoku-score" id="gomokuScore">你 0 : 0 AI</div>
            </div>
            <div class="difficulty-switch" id="gomokuDiffSwitch" style="margin: 0 auto;">
                <button class="diff-btn easy active" data-gdiff="easy" data-i18n="easy">😊 简单</button>
                <button class="diff-btn medium" data-gdiff="medium" data-i18n="medium">😐 中等</button>
                <button class="diff-btn hard" data-gdiff="hard" data-i18n="hard">😈 困难</button>
            </div>
            <div class="gomoku-board-wrapper"><div class="gomoku-board" id="gomokuBoard"></div></div>
            <div class="flex-row"><button class="btn btn-primary" id="gomokuResetBtn" data-i18n="newRound">🔄 新一局</button></div>
            <div class="message-bar" id="gomokuMessage" data-i18n="gomokuHint">9x9棋盘，五子连线获胜！</div>
        </div>
    </div>

    <!-- 记忆翻牌面板 -->
    <div id="memoryPanel" class="game-panel">
        <div class="memory-area">
            <div class="memory-info">
                <div class="memory-stat"><span data-i18n="pairs">🎯 配对:</span> <strong id="memoryPairs">0 / 8</strong></div>
                <div class="memory-stat"><span data-i18n="moves">🔢 步数:</span> <strong id="memoryMoves">0</strong></div>
                <div class="memory-stat"><span data-i18n="time">⏱️ 时间:</span> <strong id="memoryTime">0s</strong></div>
            </div>
            <div class="memory-board" id="memoryBoard"></div>
            <div class="flex-row"><button class="btn btn-primary" id="memoryResetBtn" data-i18n="newRound">🔄 新一局</button></div>
            <div class="memory-log" id="memoryLog"><p data-i18n="memoryHint">点击卡片翻牌，找出所有配对！</p></div>
        </div>
    </div>

    <!-- 井字棋面板 -->
    <div id="tictactoePanel" class="game-panel">
        <div class="tictactoe-area">
            <div class="tictactoe-info">
                <div class="tictactoe-score"><span data-i18n="you2">🧑 你:</span> <strong id="tttPlayerScore">0</strong></div>
                <div class="tictactoe-score"><span data-i18n="aiLabel">🤖 AI:</span> <strong id="tttAIScore">0</strong></div>
                <div class="tictactoe-score"><span data-i18n="draw">🤝 平局:</span> <strong id="tttDrawScore">0</strong></div>
            </div>
            <div class="difficulty-switch" id="tttDiffSwitch" style="margin: 0 auto;">
                <button class="diff-btn easy active" data-tdiff="easy" data-i18n="easy">😊 简单</button>
                <button class="diff-btn medium" data-tdiff="medium" data-i18n="medium">😐 中等</button>
                <button class="diff-btn hard" data-tdiff="hard" data-i18n="hard">😈 困难</button>
            </div>
            <div class="tictactoe-board" id="tictactoeBoard"></div>
            <div class="flex-row"><button class="btn btn-primary" id="tttResetBtn" data-i18n="newRound">🔄 新一局</button></div>
            <div class="tictactoe-log" id="tttLog"><p data-i18n="tttHint">你是 ❌，AI是 ⭕。点击格子开始游戏！</p></div>
        </div>
    </div>

    <!-- Simon Says面板（含难度） -->
    <div id="simonPanel" class="game-panel">
        <div class="simon-area">
            <div class="simon-info">
                <div class="simon-stat"><span data-i18n="round">🎯 回合:</span> <strong id="simonRound">0</strong></div>
                <div class="simon-stat"><span data-i18n="best">🏆 最高:</span> <strong id="simonBest">0</strong></div>
                <div class="simon-stat"><span data-i18n="status">📊 状态:</span> <strong id="simonStatus" data-i18n="ready">准备</strong></div>
            </div>
            <div class="difficulty-switch" id="simonDiffSwitch" style="margin: 0 auto;">
                <button class="diff-btn easy active" data-simondiff="easy" data-i18n="easy">😊 简单</button>
