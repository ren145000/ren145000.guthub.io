        function showMole() {
            if (!whackPlaying) return;
            if (whackActiveMole !== null) {
                const prev = whackHoles[whackActiveMole];
                if (prev.active) {
                    prev.mole.classList.remove('up'); prev.active = false;
                    whackMiss++; whackMissEl.textContent = whackMiss; SFX.whackMiss();
                }
            }
            const available = whackHoles.map((h, i) => h.active ? -1 : i).filter(i => i >= 0);
            if (available.length === 0) return;
            const idx = available[Math.floor(Math.random() * available.length)];
            const h = whackHoles[idx];
            h.active = true;
            h.mole.classList.remove('hit'); h.mole.textContent = '🐹';
            h.mole.classList.add('up');
            whackActiveMole = idx;
            h.timeout = setTimeout(() => {
                if (h.active) {
                    h.mole.classList.remove('up'); h.active = false;
                    whackMiss++; whackMissEl.textContent = whackMiss; SFX.whackMiss();
                    if (whackActiveMole === idx) whackActiveMole = null;
                }
